{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "outputDirectory": "backend",
  "env": {
    "TELEGRAM_BOT_TOKEN": "@telegram-bot-token",
    "ADMIN_PIN": "@admin-pin",
    "ADMIN_PHONE_1": "@admin-phone-1",
    "ADMIN_PHONE_2": "@admin-phone-2",
    "ADMIN_BANK_ACCOUNT": "@admin-bank-account",
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/api/index.js": {
      "memory": 3008,
      "maxDuration": 300
    }
  }
}
