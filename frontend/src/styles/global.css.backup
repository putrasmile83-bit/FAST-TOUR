/* ============================================
   FAST TOUR - Okalpha Theme
   Color Palette:
   - Primary Red: #e63946
   - Background White: #ffffff
   - Accent Yellow: #ffd700
   ============================================ */

:root {
  /* Colors */
  --primary-color: #ffffff;
  --color-primary-red: #e63946;
  --color-primary-red-dark: #c92a2a;
  --color-primary-red-light: #ff8a9b;
  --color-white: #ffffff;
  --color-light-gray: #f8f9fa;
  --color-gray: #e9ecef;
  --color-dark-gray: #6c757d;
  --color-accent-yellow: #ffd700;
  --color-accent-yellow-light: #fff8dc;
  
  /* Legacy variables (for compatibility) */
  --secondary-color: #e63946;
  --accent-color: #ffd700;
  --text-dark: #000000;
  --text-light: #666666;
  --border-color: #e9ecef;
  
  /* Gradients */
  --gradient-primary: linear-gradient(135deg, #e63946 0%, #c92a2a 100%);
  --gradient-light: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  --gradient-accent: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  
  /* Shadows */
  --shadow: 0 8px 16px rgba(230, 57, 70, 0.12);
  --shadow-heavy: 0 16px 32px rgba(230, 57, 70, 0.16);
  --shadow-sm: 0 2px 4px rgba(230, 57, 70, 0.08);
  --shadow-md: 0 8px 16px rgba(230, 57, 70, 0.12);
  --shadow-lg: 0 16px 32px rgba(230, 57, 70, 0.16);
  
  /* Typography */
  --font-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  --font-mono: 'Courier New', monospace;
  --font-pixel: 'Press Start 2P', cursive;
  
  /* Spacing */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-2xl: 48px;
  
  /* Border Radius */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-full: 50%;
  
  /* Transitions */
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-fast: 150ms ease;
  --transition-base: 300ms ease;
  --transition-slow: 500ms ease;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #root {
  width: 100%;
  height: 100%;
}

body {
  font-family: 'Inter', sans-serif;
  background-color: var(--primary-color);
  color: var(--text-dark);
  line-height: 1.6;
  overflow-x: hidden;
}

/* PIXEL FONT */
.pixel-font {
  font-family: 'Press Start 2P', cursive;
  letter-spacing: 2px;
}

/* BUTTONS */
.btn {
  padding: 12px 24px;
  border: none;
  background: var(--gradient-primary);
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
  font-size: 14px;
  text-transform: uppercase;
  border-radius: var(--radius-lg);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: var(--shadow-md);
}
  letter-spacing: 1px;
}

.btn:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--shadow-heavy);
  background-color: var(--secondary-color);
  color: var(--primary-color);
}

.btn:active {
  transform: translate(0, 0);
}

.btn-primary {
  background-color: var(--secondary-color);
  color: var(--primary-color);
  border-color: var(--secondary-color);
}

.btn-primary:hover {
  background-color: var(--primary-color);
  color: var(--secondary-color);
}

.btn-secondary {
  background-color: var(--accent-color);
  color: var(--text-dark);
  border-color: var(--accent-color);
}

.btn-secondary:hover {
  background-color: var(--text-dark);
  color: var(--accent-color);
}

/* CARDS */
.card {
  background-color: var(--primary-color);
  border: 3px solid var(--text-dark);
  padding: 20px;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.card:hover {
  transform: translate(-3px, -3px);
  box-shadow: var(--shadow-heavy);
}

/* CONTAINERS */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  margin: 20px 0;
}

/* INPUTS */
input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 2px solid var(--text-dark);
  background-color: var(--primary-color);
  color: var(--text-dark);
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  transition: var(--transition);
}

input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--secondary-color);
  box-shadow: 0 0 0 3px rgba(255, 0, 0, 0.1);
}

/* ANIMATIONS */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.animate-slide {
  animation: slideIn 0.5s ease-out;
}

.animate-fade {
  animation: fadeIn 0.5s ease-out;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

.animate-bounce {
  animation: bounce 1s infinite;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .row {
    grid-template-columns: 1fr;
  }

  .btn {
    padding: 10px 16px;
    font-size: 12px;
  }

  .pixel-font {
    font-size: 14px;
  }
}
